// ============================================================
// SELECT ALERT
// ============================================================

void updateAlert()
{
    // --------------------------------------------------------
    // SENSOR FAULT
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "SENSOR FAULT")
    {
        sensorFaultAlert();

        return;
    }


    // --------------------------------------------------------
    // CRITICAL
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "CRITICAL")
    {
        criticalAlert();

        return;
    }


    // --------------------------------------------------------
    // WARNING
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "WARNING")
    {
        warningAlert();

        return;
    }


    // --------------------------------------------------------
    // WATCH
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "WATCH")
    {
        watchAlert();

        return;
    }


    // --------------------------------------------------------
    // NORMAL
    // --------------------------------------------------------

    normalAlert();
}


// ============================================================
// NORMAL ALERT
// ============================================================

void normalAlert()
{
    digitalWrite(
        GREEN_LED,
        HIGH
    );

    digitalWrite(
        YELLOW_LED,
        LOW
    );

    digitalWrite(
        RED_LED,
        LOW
    );

    digitalWrite(
        BUZZER,
        LOW
    );


    Serial.println(
        "[ALERT] NORMAL"
    );
}


// ============================================================
// WATCH ALERT
// ============================================================

void watchAlert()
{
    digitalWrite(
        GREEN_LED,
        LOW
    );

    digitalWrite(
        YELLOW_LED,
        HIGH
    );

    digitalWrite(
        RED_LED,
        LOW
    );

    digitalWrite(
        BUZZER,
        LOW
    );


    Serial.println();
    Serial.println(
        "[ALERT] WATCH"
    );
}


// ============================================================
// WARNING ALERT
// ============================================================

void warningAlert()
{
    digitalWrite(
        GREEN_LED,
        LOW
    );

    digitalWrite(
        YELLOW_LED,
        HIGH
    );

    digitalWrite(
        RED_LED,
        LOW
    );


    /*
     * Short warning beep.
     */

    digitalWrite(
        BUZZER,
        HIGH
    );

    delay(150);

    digitalWrite(
        BUZZER,
        LOW
    );


    Serial.println();
    Serial.println(
        "[ALERT] WARNING"
    );
}


// ============================================================
// CRITICAL ALERT
// ============================================================

void criticalAlert()
{
    digitalWrite(
        GREEN_LED,
        LOW
    );

    digitalWrite(
        YELLOW_LED,
        LOW
    );

    digitalWrite(
        RED_LED,
        HIGH
    );


    Serial.println();
    Serial.println(
        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    );

    Serial.println(
        "!!!        CRITICAL ALERT         !!!"
    );

    Serial.println(
        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    );


    /*
     * Three strong buzzer pulses.
     */

    for (int i = 0; i < 3; i++)
    {
        digitalWrite(
            BUZZER,
            HIGH
        );

        delay(200);


        digitalWrite(
            BUZZER,
            LOW
        );

        delay(100);
    }
}


// ============================================================
// SENSOR FAULT ALERT
// ============================================================

void sensorFaultAlert()
{
    digitalWrite(
        GREEN_LED,
        LOW
    );

    digitalWrite(
        YELLOW_LED,
        HIGH
    );

    digitalWrite(
        RED_LED,
        HIGH
    );

    digitalWrite(
        BUZZER,
        LOW
    );


    Serial.println();
    Serial.println(
        "[ALERT] UPSTREAM SENSOR FAULT"
    );
}


// ============================================================
// CHECK COMMUNICATION
// ============================================================

void checkCommunication()
{
    /*
     * No timeout before first packet.
     */

    if (lastPacketTime == 0)
    {
        return;
    }


    unsigned long elapsed =
        millis() -
        lastPacketTime;


    /*
     * Communication lost.
     */

    if (elapsed >
        COMMUNICATION_TIMEOUT_MS)
    {
        if (!communicationLost)
        {
            communicationLost = true;

            communicationLostAlert();
        }
    }
}


// ============================================================
// COMMUNICATION LOST ALERT
// ============================================================

void communicationLostAlert()
{
    digitalWrite(
        GREEN_LED,
        LOW
    );

    digitalWrite(
        YELLOW_LED,
        LOW
    );

    digitalWrite(
        RED_LED,
        HIGH
    );

    digitalWrite(
        BUZZER,
        LOW
    );


    Serial.println();

    Serial.println(
        "=========================================="
    );

    Serial.println(
        "       !!! COMMUNICATION LOST !!!"
    );

    Serial.println(
        "=========================================="
    );

    Serial.println(
        "No STM32 packet received for 5 seconds."
    );


    Serial.print(
        "Last packet number: "
    );

    Serial.println(
        lastPacketNumber
    );


    Serial.print(
        "Packets received: "
    );

    Serial.println(
        receivedPackets
    );


    Serial.print(
        "Packets missed: "
    );

    Serial.println(
        missedPackets
    );
}
