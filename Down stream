// ============================================================
// SELECT ALERT
// ============================================================

void updateAlert()
{
    // --------------------------------------------------------
    // SENSOR FAULT
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "SENSOR FAULT")
    {
        sensorFaultAlert();

        return;
    }


    // --------------------------------------------------------
    // CRITICAL
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "CRITICAL")
    {
        criticalAlert();

        return;
    }


    // --------------------------------------------------------
    // WARNING
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "WARNING")
    {
        warningAlert();

        return;
    }


    // --------------------------------------------------------
    // WATCH
    // --------------------------------------------------------

    if (currentPacket.fusionState ==
        "WATCH")
    {
        watchAlert();

        return;
    }


    // --------------------------------------------------------
    // NORMAL
    // --------------------------------------------------------

    normalAlert();
}


// ============================================================
// NORMAL ALERT
// ============================================================

void normalAlert()
{
    digitalWrite(
        GREEN_LED,
        HIGH
    );

    digitalWrite(
        YELLOW_LED,
        LOW
    );

    digitalWrite(
        RED_LED,
        LOW
    );

    digitalWrite(
        BUZZER,
        LOW
    );


    Serial.println(
        "[ALERT] NORMAL"
    );
}


// ============================================================
// WATCH ALERT
// ============================================================

void watchAlert()
{
    digitalWrite(
