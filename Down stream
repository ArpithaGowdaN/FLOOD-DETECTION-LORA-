void handleDashboardRoot()
{
    dashboardServer.send(200, "text/html", DASHBOARD_HTML);
}

void startOfflineDashboard()
{
    WiFi.mode(WIFI_AP);
    if (WiFi.softAP(AP_SSID, AP_PASSWORD)) {
        Serial.println();
        Serial.println("==========================================");
        Serial.println("OFFLINE WIFI DASHBOARD STARTED");
        Serial.println("SSID: " + String(AP_SSID));
        Serial.println("Password: " + String(AP_PASSWORD));
        Serial.print("IP address: ");
        Serial.println(WiFi.softAPIP());
        Serial.println("Open http://192.168.4.1");
        Serial.println("==========================================");
    } else {
        Serial.println("[WIFI] AP START FAILED");
    }

    dashboardServer.on("/", handleDashboardRoot);
    dashboardServer.on("/api/status", handleDashboardStatus);
    dashboardServer.on("/api/history", handleDashboardHistory);
    dashboardServer.on("/api/health", handleDashboardHealth);
    dashboardServer.on("/api/metrics", handleDashboardMetrics);
    dashboardServer.begin();
}


// ============================================================
// FUNCTION DECLARATIONS
// ============================================================

bool initializeLoRa();

bool receiveLoRaPacket(String &message);

bool parsePacket(String message, FloodPacket &packet);

String getValue(String data, String key);

bool packetContainsRequiredFields(String message);

void processPacket(FloodPacket &packet);

void updateAlert();

void normalAlert();

void watchAlert();

void warningAlert();

void criticalAlert();

void sensorFaultAlert();

void communicationLostAlert();

void printPacket(FloodPacket &packet);

void checkCommunication();


// ============================================================
// SETUP
// ============================================================

void setup()
{
    Serial.begin(115200);

    delay(1000);

    Serial.println();
    Serial.println();
    Serial.println("==========================================");
    Serial.println("   OFF-GRID FLASH FLOOD ALERT NODE");
    Serial.println("==========================================");
    Serial.println("ESP32 + SX1278 RA-02");
    Serial.println("------------------------------------------");


    // --------------------------------------------------------
    // ALERT PINS
    // --------------------------------------------------------

    pinMode(GREEN_LED, OUTPUT);
    pinMode(YELLOW_LED, OUTPUT);
    pinMode(RED_LED, OUTPUT);
    pinMode(BUZZER, OUTPUT);


    // Initially OFF

    digitalWrite(GREEN_LED, LOW);
    digitalWrite(YELLOW_LED, LOW);
    digitalWrite(RED_LED, LOW);
    digitalWrite(BUZZER, LOW);


    // --------------------------------------------------------
    // SPI INITIALIZATION
    // --------------------------------------------------------

    SPI.begin(
        LORA_SCK,
        LORA_MISO,
        LORA_MOSI,
        LORA_SS
    );


    // --------------------------------------------------------
    // LORA INITIALIZATION
    // --------------------------------------------------------

    if (initializeLoRa())
    {
        Serial.println();
        Serial.println("[LORA] Initialization SUCCESS");
    }
    else
    {
        Serial.println();
        Serial.println("[LORA] Initialization FAILED");

        /*
         * Hardware initialization failed.
         * Blink RED LED continuously.
         */

        while (true)
        {
            digitalWrite(
                RED_LED,
                HIGH
            );

            delay(300);

            digitalWrite(
                RED_LED,
                LOW
            );

            delay(300);
        }
    }


    Serial.println("------------------------------------------");
    Serial.println("Waiting for STM32 upstream node...");
    Serial.println("------------------------------------------");


    /*
     * Initial status.
     */

    normalAlert();

    // Start the local offline Wi-Fi dashboard.
    startOfflineDashboard();
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
    dashboardServer.handleClient();

    if (millis() - lastHistorySample >= HISTORY_INTERVAL_MS)
    {
        lastHistorySample = millis();
        if (currentPacket.valid) addDashboardHistory();
    }

    String message;


    // --------------------------------------------------------
    // CHECK FOR INCOMING LORA PACKET
    // --------------------------------------------------------

    if (receiveLoRaPacket(message))
    {
        Serial.println();
        Serial.println("==========================================");
        Serial.println("[LORA] PACKET RECEIVED");
        Serial.println("==========================================");

        Serial.println(message);


        // ----------------------------------------------------
        // VALIDATE PACKET
        // ----------------------------------------------------

        if (!packetContainsRequiredFields(message))
        {
            Serial.println(
                "[LORA] Ignored non-UP01/invalid packet"
            );
        }
        else
        {
            // ----------------------------------------------------
            // PARSE PACKET
            // ----------------------------------------------------

            FloodPacket packet;

            if (parsePacket(message, packet))
        {
            /*
             * Store received packet.
             */

            currentPacket = packet;


            /*
             * Communication is alive.
             */

            lastPacketTime = millis();

            communicationLost = false;


            /*
             * Process packet.
             */

            processPacket(
                currentPacket
            );


            /*
             * Print decoded information.
             */

            printPacket(
                currentPacket
            );


            /*
             * Generate appropriate alert.
             */

            updateAlert();
        }
            else
            {
                Serial.println(
                    "[ERROR] Packet parsing FAILED"
                );
            }
        }
    }


    // --------------------------------------------------------
    // CHECK COMMUNICATION TIMEOUT
    // --------------------------------------------------------

    checkCommunication();


    delay(10);
}


// ============================================================
// INITIALIZE LORA
// ============================================================

bool initializeLoRa()
{
    Serial.println(
        "[LORA] Starting SX1278..."
    );


    // --------------------------------------------------------
    // SET LORA PINS
    // --------------------------------------------------------

    LoRa.setPins(
        LORA_SS,
        LORA_RST,
        LORA_DIO0
    );


    // --------------------------------------------------------
    // START LORA
    // --------------------------------------------------------

    if (!LoRa.begin(LORA_FREQUENCY))
    {
        return false;
    }


    // --------------------------------------------------------
    // MATCH STM32 LORA SETTINGS
    // --------------------------------------------------------

    /*
     * Bandwidth:
     * 125 kHz
     */

    LoRa.setSignalBandwidth(
        LORA_BANDWIDTH
    );


    /*
     * Spreading Factor:
     * SF7
     */

    LoRa.setSpreadingFactor(
        LORA_SPREADING
    );


    /*
     * Coding Rate:
     * 4/5
     */

    LoRa.setCodingRate4(
        LORA_CODING_RATE
    );


    /*
     * Preamble:
     * 8 symbols
     */

    LoRa.setPreambleLength(
        LORA_PREAMBLE
    );


    /*
     * Enable CRC.
     */

    LoRa.enableCrc();


    /*
     * IMPORTANT:
     *
     * DO NOT call:
     *
     * LoRa.explicitHeader();
     *
     * or
     *
     * LoRa.explicitHeaderMode();
     *
     * because your installed library keeps that function
     * private.
     *
     * The library's default packet mode is compatible with
     * the STM32 explicit-header configuration.
     */


    /*
     * Start receiver.
     */

    LoRa.receive();


    // --------------------------------------------------------
    // PRINT CONFIGURATION
    // --------------------------------------------------------

    Serial.println();
    Serial.println(
        "[LORA] Configuration"
    );

    Serial.println(
        "------------------------------------------"
    );

    Serial.println(
        "Frequency : 433 MHz"
    );

    Serial.println(
        "Bandwidth : 125 kHz"
    );

    Serial.println(
        "SF        : 7"
    );

    Serial.println(
        "Coding    : 4/5"
    );

    Serial.println(
        "Preamble  : 8"
    );

    Serial.println(
        "CRC       : ON"
    );

    Serial.println(
        "Header    : DEFAULT"
    );

    Serial.println(
        "------------------------------------------"
    );


    return true;
}


// ============================================================
// RECEIVE LORA PACKET
// ============================================================

bool receiveLoRaPacket(String &message)
{
    int packetSize = LoRa.parsePacket();


    /*
     * No packet available.
     */

    if (packetSize == 0)
    {
        return false;
    }


    /*
     * Clear previous message.
     */

    message = "";


    /*
     * Read complete LoRa packet.
     */

    while (LoRa.available())
    {
        message += (char)LoRa.read();
    }


    /*
     * Display radio information.
     */

    Serial.print(
        "[LORA] RSSI : "
    );

    Serial.print(
        LoRa.packetRssi()
    );

    Serial.println(
        " dBm"
    );


    Serial.print(
        "[LORA] SNR  : "
    );

    Serial.print(
        LoRa.packetSnr()
    );

    Serial.println(
        " dB"
    );


    return true;
}


// ============================================================
// VALIDATE PACKET STRUCTURE
// ============================================================

bool packetContainsRequiredFields(
    String message
)
{
    if (!message.startsWith("ID=UP01,"))
    {
        return false;
    }


    if (message.indexOf("PKT=") < 0)
    {
        return false;
    }


    if (message.indexOf("LEVEL=") < 0)
    {
        return false;
    }


    if (message.indexOf("RATE=") < 0)
    {
        return false;
    }


    if (message.indexOf("WT=") < 0)
    {
        return false;
    }


    if (message.indexOf("VIB=") < 0)
    {
        return false;
    }


    if (message.indexOf("VS=") < 0)
    {
        return false;
    }


    if (message.indexOf("WH=") < 0)
    {
        return false;
    }


    if (message.indexOf("VH=") < 0)
    {
        return false;
    }


    if (message.indexOf("FUSION=") < 0)
    {
        return false;
    }


    return true;
}


// ============================================================
// EXTRACT VALUE FROM PACKET
// ============================================================
//
// Example:
//
// LEVEL=45.20
//
// getValue(message, "LEVEL=")
//
// returns:
//
// 45.20
//

String getValue(
    String data,
    String key
)
{
    int start =
        data.indexOf(key);


    if (start < 0)
    {
        return "";
    }


    start += key.length();


    int end =
        data.indexOf(
            ",",
            start
        );


    if (end < 0)
    {
        end = data.length();
    }


    return data.substring(
        start,
        end
    );
}


// ============================================================
// PARSE PACKET
// ============================================================

bool parsePacket(
    String message,
    FloodPacket &packet
)
{
    String value;


    packet.valid = false;


    // --------------------------------------------------------
    // NODE ID
    // --------------------------------------------------------

    value =
        getValue(
            message,
            "ID="
        );


    if (value.length() == 0)
    {
        return false;
    }


    packet.nodeID =
        value;


    // --------------------------------------------------------
    // PACKET NUMBER
    // --------------------------------------------------------

    value =
        getValue(
            message,
            "PKT="
        );


    if (value.length() == 0)
    {
        return false;
    }


    packet.packetNumber =
        strtoul(
            value.c_str(),
            NULL,
            10
        );


    // --------------------------------------------------------
    // WATER LEVEL
    // --------------------------------------------------------

    value =
        getValue(
            message,
            "LEVEL="
        );


    if (value.length() == 0)
    {
        return false;
    }


    packet.waterLevel =
        value.toFloat();


    // --------------------------------------------------------
    // WATER RISE RATE
    // --------------------------------------------------------

    value =
        getValue(
            message,
            "RATE="
        );


    if (value.length() == 0)
    {
        return false;
    }


    packet.waterRate =
        value.toFloat();


    // --------------------------------------------------------
    // WATER TREND
    // --------------------------------------------------------

    packet.waterTrend =
        getValue(
            message,
            "WT="
        );


    // --------------------------------------------------------
    // VIBRATION
    // --------------------------------------------------------

    value =
        getValue(
            message,
            "VIB="
        );


    if (value.length() == 0)
    {
        return false;
    }


    packet.vibration =
        value.toFloat();


    // --------------------------------------------------------
    // VIBRATION STATE
    // --------------------------------------------------------

    packet.vibrationState =
        getValue(
            message,
            "VS="
        );


    // --------------------------------------------------------
    // WATER HEALTH
    // --------------------------------------------------------

    packet.waterHealth =
        getValue(
            message,
            "WH="
        );


    // --------------------------------------------------------
    // VIBRATION HEALTH
    // --------------------------------------------------------

    packet.vibrationHealth =
        getValue(
            message,
            "VH="
        );


    // --------------------------------------------------------
    // FUSION STATE
    // --------------------------------------------------------

    value =
        getValue(
            message,
            "FUSION="
        );


    if (value.length() == 0)
    {
        return false;
    }


    packet.fusionState =
        value;


    // --------------------------------------------------------
    // RADIO INFORMATION
    // --------------------------------------------------------

    packet.rssi =
        LoRa.packetRssi();


    packet.snr =
        LoRa.packetSnr();


    packet.valid = true;


    return true;
}


// ============================================================
// PROCESS PACKET
// ============================================================

void processPacket(
    FloodPacket &packet
)
{
    receivedPackets++;


    // --------------------------------------------------------
    // FIRST PACKET
    // --------------------------------------------------------

    if (lastPacketNumber == 0)
    {
        lastPacketNumber =
            packet.packetNumber;


        Serial.println(
            "[PACKET] First packet received"
        );


        return;
    }


    // --------------------------------------------------------
    // DUPLICATE PACKET
    // --------------------------------------------------------

    if (packet.packetNumber ==
        lastPacketNumber)
    {
        duplicatePackets++;


        Serial.println(
            "[PACKET] DUPLICATE packet"
        );


        return;
    }


    // --------------------------------------------------------
    // NEW PACKET
    // --------------------------------------------------------

    if (packet.packetNumber >
        lastPacketNumber)
    {
        /*
         * Check for missed packets.
         */

        if (packet.packetNumber >
            lastPacketNumber + 1)
        {
            unsigned long missed =
                packet.packetNumber -
                lastPacketNumber -
                1;


            missedPackets +=
                missed;


            Serial.print(
                "[PACKET] Missed packets: "
            );

            Serial.println(
                missed
            );
        }


        lastPacketNumber =
            packet.packetNumber;


        return;
    }


    // --------------------------------------------------------
    // OLD / OUT OF ORDER PACKET
    // --------------------------------------------------------

    Serial.println(
        "[PACKET] OUT-OF-ORDER packet"
    );
}


