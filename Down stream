// ============================================================
// CRITICAL ALERT
// ============================================================

void criticalAlert()
{
    digitalWrite(GREEN_LED, LOW);
    digitalWrite(YELLOW_LED, LOW);
    digitalWrite(RED_LED, HIGH);

    Serial.println();
    Serial.println("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");
    Serial.println("!!!        CRITICAL ALERT         !!!");
    Serial.println("!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!");

    // Five strong buzzer pulses.
    for (int i = 0; i < 5; i++)
    {
        digitalWrite(BUZZER, HIGH);
        delay(300);
        digitalWrite(BUZZER, LOW);
        delay(150);
    }
}


// ============================================================
// SENSOR FAULT ALERT
// ============================================================

void sensorFaultAlert()
{
    digitalWrite(GREEN_LED, LOW);
    digitalWrite(YELLOW_LED, HIGH);
    digitalWrite(RED_LED, HIGH);

    Serial.println();
    Serial.println("==========================================");
    Serial.println("       !!! SENSOR FAULT !!!");
    Serial.println("==========================================");
    Serial.println("Upstream sensor fault reported by STM32.");

    // Three short fault beeps.
    for (int i = 0; i < 3; i++)
    {
        digitalWrite(BUZZER, HIGH);
        delay(200);
        digitalWrite(BUZZER, LOW);
        delay(200);
    }
}


// ============================================================
// CHECK COMMUNICATION
// ============================================================

void checkCommunication()
{
    /*
     * No timeout before first packet.
     */

    if (lastPacketTime == 0)
    {
        return;
    }


    unsigned long elapsed =
        millis() -
        lastPacketTime;


    /*
     * Communication lost.
     */

    if (elapsed >
        COMMUNICATION_TIMEOUT_MS)
    {
        if (!communicationLost)
        {
            communicationLost = true;

            communicationLostAlert();
        }
    }
}


// ============================================================
// COMMUNICATION LOST ALERT
// ============================================================

void communicationLostAlert()
{
    digitalWrite(GREEN_LED, LOW);
    digitalWrite(YELLOW_LED, LOW);
    digitalWrite(RED_LED, HIGH);

    Serial.println();
    Serial.println("==========================================");
    Serial.println("       !!! COMMUNICATION LOST !!!");
    Serial.println("==========================================");
    Serial.println("No STM32 packet received for 5 seconds.");

    Serial.print("Last packet number: ");
    Serial.println(lastPacketNumber);

    Serial.print("Packets received: ");
    Serial.println(receivedPackets);

    Serial.print("Packets missed: ");
    Serial.println(missedPackets);

    // Five communication-loss beeps.
    for (int i = 0; i < 5; i++)
    {
        digitalWrite(BUZZER, HIGH);
        delay(200);
        digitalWrite(BUZZER, LOW);
        delay(200);
    }
}
