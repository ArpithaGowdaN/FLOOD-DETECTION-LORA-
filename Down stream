/*
 * ============================================================
 * OFF-GRID FLASH FLOOD EARLY WARNING SYSTEM
 *
 * ESP32 - LoRa RECEIVER + ALERT NODE
 *
 * RECEIVES DATA FROM:
 * STM32F446RE + SX1278 RA-02
 *
 * ============================================================
 *
 * STM32 PACKET FORMAT:
 *
 * ID=UP01,PKT=25,LEVEL=45.20,RATE=3.25,
 * WT=RAPID RISING,VIB=0.253,VS=HIGH,
 * WH=OK,VH=OK,FUSION=CRITICAL
 *
 * ============================================================
 *
 * ESP32 RESPONSIBILITIES:
 *
 * 1. Receive LoRa packet
 * 2. Validate packet
 * 3. Parse packet
 * 4. Monitor packet sequence
 * 5. Detect communication loss
 * 6. Generate local alert
 *
 * ============================================================
 *
 * LORA CONFIGURATION:
 *
 * Frequency  = 433 MHz
 * SF         = 7
 * Bandwidth  = 125 kHz
 * Coding     = 4/5
 * CRC        = ON
 * Preamble   = 8
 *
 * ============================================================
 */

#include <Arduino.h>
#include <SPI.h>
#include <LoRa.h>
#include <WiFi.h>
#include <WebServer.h>


// ============================================================
// SX1278 RA-02 -> ESP32 CONNECTIONS
// ============================================================

#define LORA_SCK        18
#define LORA_MISO       19
#define LORA_MOSI       23
#define LORA_SS         5
#define LORA_RST        14
#define LORA_DIO0       26


// ============================================================
// ALERT OUTPUT PINS
// ============================================================

#define GREEN_LED       25
#define YELLOW_LED      27
#define RED_LED         32
#define BUZZER          33


// ============================================================
// LORA CONFIGURATION
// ============================================================

#define LORA_FREQUENCY      433E6
#define LORA_BANDWIDTH      125E3
#define LORA_SPREADING      7
#define LORA_CODING_RATE    5
#define LORA_PREAMBLE       8


// ============================================================
// COMMUNICATION TIMEOUT
// ============================================================
//
// STM32 sensor processing takes some time before each
// transmission, therefore 5 seconds is used.
//

#define COMMUNICATION_TIMEOUT_MS    5000


// ============================================================
// FLOOD PACKET STRUCTURE
// ============================================================

struct FloodPacket
{
    String nodeID;

    unsigned long packetNumber;

    float waterLevel;

    float waterRate;

    String waterTrend;

    float vibration;

    String vibrationState;

    String waterHealth;

    String vibrationHealth;

    String fusionState;

    int rssi;

    float snr;

    bool valid;
};


// ============================================================
// GLOBAL VARIABLES
// ============================================================

FloodPacket currentPacket;

unsigned long lastPacketTime = 0;

unsigned long receivedPackets = 0;

unsigned long missedPackets = 0;

unsigned long duplicatePackets = 0;

unsigned long lastPacketNumber = 0;

bool communicationLost = true;


// ============================================================
// OFFLINE WIFI DASHBOARD
// ============================================================
#define AP_SSID "FloodWarning-ESP32"
#define AP_PASSWORD "flood1234"
#define BATTERY_ADC_PIN 34
#define BATTERY_RTOP_OHM 100000.0f
#define BATTERY_RBOTTOM_OHM 100000.0f
#define HISTORY_SIZE 60

WebServer dashboardServer(80);

struct HistoryPoint {
    unsigned long t;
    float level;
    float rate;
    float vibration;
    int rssi;
    float snr;
    float battery;
};

HistoryPoint historyData[HISTORY_SIZE];
int historyCount = 0;
int historyWrite = 0;
unsigned long lastHistorySample = 0;
const unsigned long HISTORY_INTERVAL_MS = 1000;

float readBatteryVoltage()
{
    analogSetPinAttenuation(BATTERY_ADC_PIN, ADC_11db);
    int raw = analogRead(BATTERY_ADC_PIN);
    float adcVoltage = (raw / 4095.0f) * 3.3f;
    return adcVoltage * ((BATTERY_RTOP_OHM + BATTERY_RBOTTOM_OHM) / BATTERY_RBOTTOM_OHM);
}

float batteryPercent(float v)
{
    // Approximate 1S Li-ion voltage estimate only.
    if (v <= 3.20f) return 0.0f;
    if (v >= 4.20f) return 100.0f;
    return ((v - 3.20f) / 1.00f) * 100.0f;
}

String jsonEscape(String s)
{
    s.replace("\\", "\\\\");
    s.replace("\"", "\\\"");
    s.replace("\n", "\\n");
    s.replace("\r", "\\r");
    return s;
}

void addDashboardHistory()
{
    HistoryPoint &p = historyData[historyWrite];
    p.t = millis();
    p.level = currentPacket.waterLevel;
    p.rate = currentPacket.waterRate;
    p.vibration = currentPacket.vibration;
    p.rssi = currentPacket.rssi;
    p.snr = currentPacket.snr;
    p.battery = readBatteryVoltage();

    historyWrite = (historyWrite + 1) % HISTORY_SIZE;
    if (historyCount < HISTORY_SIZE) historyCount++;
}

void handleDashboardStatus()
{
    unsigned long now = millis();
    float age = (lastPacketTime == 0 || communicationLost) ? 9999.0f : (now - lastPacketTime) / 1000.0f;
    float bv = readBatteryVoltage();

    String json = "{";
    json += "\"nodeID\":\"" + jsonEscape(currentPacket.nodeID) + "\",";
    json += "\"packetNumber\":" + String(currentPacket.packetNumber) + ",";
    json += "\"waterLevel\":" + String(currentPacket.waterLevel,2) + ",";
    json += "\"waterRate\":" + String(currentPacket.waterRate,2) + ",";
    json += "\"waterTrend\":\"" + jsonEscape(currentPacket.waterTrend) + "\",";
    json += "\"vibration\":" + String(currentPacket.vibration,3) + ",";
    json += "\"vibrationState\":\"" + jsonEscape(currentPacket.vibrationState) + "\",";
    json += "\"waterHealth\":\"" + jsonEscape(currentPacket.waterHealth) + "\",";
    json += "\"vibrationHealth\":\"" + jsonEscape(currentPacket.vibrationHealth) + "\",";
    json += "\"fusionState\":\"" + jsonEscape(currentPacket.fusionState) + "\",";
    json += "\"rssi\":" + String(currentPacket.rssi) + ",";
    json += "\"snr\":" + String(currentPacket.snr,2) + ",";
    json += "\"receivedPackets\":" + String(receivedPackets) + ",";
    json += "\"missedPackets\":" + String(missedPackets) + ",";
    json += "\"duplicatePackets\":" + String(duplicatePackets) + ",";
    json += "\"packetAge\":" + String(age,1) + ",";
    json += "\"communicationLost\":" + String(communicationLost ? "true" : "false") + ",";
    json += "\"batteryVoltage\":" + String(bv,2) + ",";
    json += "\"batteryPercent\":" + String(batteryPercent(bv),0) + ",";
    json += "\"freeHeap\":" + String(ESP.getFreeHeap()) + ",";
    json += "\"cpuMHz\":" + String(getCpuFrequencyMhz()) + ",";
    json += "\"uptime\":" + String(millis()/1000) + ",";
    json += "\"clients\":" + String(WiFi.softAPgetStationNum());
    json += "}";
    dashboardServer.send(200, "application/json", json);
}

void handleDashboardHistory()
{
    String json = "[";
    int start = (historyCount < HISTORY_SIZE) ? 0 : historyWrite;
    for (int i=0; i<historyCount; i++) {
        int idx = (start + i) % HISTORY_SIZE;
        if (i) json += ",";
        json += "{";
        json += "\"t\":" + String(historyData[idx].t) + ",";
        json += "\"level\":" + String(historyData[idx].level,2) + ",";
        json += "\"rate\":" + String(historyData[idx].rate,2) + ",";
        json += "\"vibration\":" + String(historyData[idx].vibration,3) + ",";
        json += "\"rssi\":" + String(historyData[idx].rssi) + ",";
        json += "\"snr\":" + String(historyData[idx].snr,2) + ",";
        json += "\"battery\":" + String(historyData[idx].battery,2);
        json += "}";
    }
    json += "]";
    dashboardServer.send(200, "application/json", json);
}

void handleDashboardHealth()
{
    String json = "{";
    json += "\"communicationLost\":" + String(communicationLost ? "true" : "false") + ",";
    json += "\"waterHealth\":\"" + jsonEscape(currentPacket.waterHealth) + "\",";
    json += "\"vibrationHealth\":\"" + jsonEscape(currentPacket.vibrationHealth) + "\",";
    json += "\"fusionState\":\"" + jsonEscape(currentPacket.fusionState) + "\"";
    json += "}";
    dashboardServer.send(200, "application/json", json);
}

void handleDashboardMetrics()
{
    String json = "{";
    json += "\"rssi\":" + String(currentPacket.rssi) + ",";
    json += "\"snr\":" + String(currentPacket.snr,2) + ",";
    json += "\"receivedPackets\":" + String(receivedPackets) + ",";
    json += "\"missedPackets\":" + String(missedPackets) + ",";
    json += "\"duplicatePackets\":" + String(duplicatePackets) + ",";
    json += "\"freeHeap\":" + String(ESP.getFreeHeap()) + ",";
    json += "\"cpuMHz\":" + String(getCpuFrequencyMhz());
    json += "}";
    dashboardServer.send(200, "application/json", json);
}

