{
    return DWT->CYCCNT /
           (SystemCoreClock / 1000000U);
}


/* ============================================================
   FLOAT PRINT
   ============================================================ */

void PrintFloat2(float value)
{
    int32_t scaled;

    if (value < 0.0f)
    {
        printf("-");

        value = -value;
    }

    scaled =
        (int32_t)(value * 100.0f + 0.5f);

    printf("%ld.%02ld",
           (long)(scaled / 100),
           (long)(scaled % 100));
}


void PrintFloat3(float value)
{
    int32_t scaled;

    if (value < 0.0f)
    {
        printf("-");

        value = -value;
    }

    scaled =
        (int32_t)(value * 1000.0f + 0.5f);

    printf("%ld.%03ld",
           (long)(scaled / 1000),
           (long)(scaled % 1000));
}


/* ============================================================
   JSN-SR04T
   ============================================================ */

uint8_t JSN_ReadDistance(float *distance)
{
    uint32_t start;
    uint32_t echo_start;
    uint32_t echo_end;

    uint32_t echo_time;


    HAL_GPIO_WritePin(
        JSN_TRIG_PORT,
        JSN_TRIG_PIN,
        GPIO_PIN_RESET);

    HAL_Delay(1);


    HAL_GPIO_WritePin(
        JSN_TRIG_PORT,
        JSN_TRIG_PIN,
        GPIO_PIN_SET);


    uint32_t trig_start =
        DWT_GetMicros();

    while ((DWT_GetMicros() -
            trig_start) < 10)
    {
    }


    HAL_GPIO_WritePin(
        JSN_TRIG_PORT,
        JSN_TRIG_PIN,
        GPIO_PIN_RESET);


    /* WAIT ECHO HIGH */

    start = DWT_GetMicros();

    while (HAL_GPIO_ReadPin(
               JSN_ECHO_PORT,
               JSN_ECHO_PIN) ==
           GPIO_PIN_RESET)
    {
        if ((DWT_GetMicros() -
             start) > 40000)
        {
            return 0;
        }
    }


    echo_start =
        DWT_GetMicros();


    /* WAIT ECHO LOW */

    start =
        DWT_GetMicros();

    while (HAL_GPIO_ReadPin(
               JSN_ECHO_PORT,
               JSN_ECHO_PIN) ==
           GPIO_PIN_SET)
    {
        if ((DWT_GetMicros() -
             start) > 40000)
        {
            return 0;
        }
    }


    echo_end =
        DWT_GetMicros();


    echo_time =
        echo_end - echo_start;


    *distance =
        ((float)echo_time) / 58.0f;


    if (*distance <
            JSN_MIN_DISTANCE_CM ||
        *distance >
            JSN_MAX_DISTANCE_CM)
    {
        return 0;
    }


    return 1;
}


/* ============================================================
   FILTERED DISTANCE
   ============================================================ */

float JSN_ReadFilteredDistance(
    uint8_t *valid_count)
{
    float samples[JSN_SAMPLES];

    uint8_t count = 0;


    for (uint8_t i = 0;
         i < JSN_SAMPLES;
         i++)
    {
        float distance;


        if (JSN_ReadDistance(&distance))
        {
            samples[count] =
                distance;

            count++;


            printf("[JSN] Valid reading: ");

            PrintFloat2(distance);

            printf(" cm\r\n");
        }
        else
        {
            printf("[JSN] Invalid reading\r\n");
        }


        HAL_Delay(60);
    }


    *valid_count =
        count;


    if (count == 0)
    {
        return 0.0f;
    }


    /* SORT */

    for (uint8_t i = 0;
         i < count;
         i++)
    {
        for (uint8_t j = i + 1;
             j < count;
             j++)
        {
            if (samples[j] <
                samples[i])
            {
                float temp =
                    samples[i];

                samples[i] =
                    samples[j];

                samples[j] =
                    temp;
            }
        }
    }


    /* MEDIAN */

    if (count % 2)
    {
        return samples[count / 2];
    }
    else
    {
        return
            (samples[count / 2 - 1] +
             samples[count / 2]) / 2.0f;
    }
}


/* ============================================================
   WATER UPDATE
   ============================================================ */

void UpdateWaterSensor(void)
{
    static uint8_t have_previous = 0;

    static uint32_t previous_time = 0;


    uint8_t valid_count;


    float distance =
        JSN_ReadFilteredDistance(
            &valid_count);


    printf("[JSN] Valid readings: %d/5\r\n",
           valid_count);


    /* SENSOR FAILURE */

    if (valid_count <
        JSN_VALID_REQUIRED)
    {
        if (water_bad_cycles <
            SENSOR_FAULT_CYCLES)
        {
            water_bad_cycles++;
        }

        water_good_cycles = 0;


        if (water_bad_cycles >=
            SENSOR_FAULT_CYCLES)
        {
            water_health = 0;

            water_trend =
                WATER_SENSOR_FAULT;
        }

        return;
    }


    /* SENSOR GOOD */

    water_bad_cycles = 0;


    if (water_good_cycles <
        SENSOR_RECOVERY_CYCLES)
    {
        water_good_cycles++;
    }


    if (water_good_cycles >=
        SENSOR_RECOVERY_CYCLES ||
        water_health == 0)
    {
        water_health = 1;
    }


    current_distance =
        distance;


    printf("[JSN] Filtered distance: ");

    PrintFloat2(distance);

    printf(" cm\r\n");


    /* WATER LEVEL */

    float new_level =
        WATER_REFERENCE_CM -
        distance;


    if (new_level < 0.0f)
    {
        new_level = 0.0f;
    }


    current_water_level =
        new_level;


    printf("[WATER] Level: ");

    PrintFloat2(current_water_level);

    printf(" cm\r\n");


    /* RATE */

    uint32_t now =
        HAL_GetTick();


    /*
     * IMPORTANT:
     * Do NOT calculate rate on the first
     * valid measurement.
     */

    if (have_previous)
    {
        uint32_t dt_ms =
            now - previous_time;


        if (dt_ms > 100)
        {
            float dt_min =
                ((float)dt_ms) /
                60000.0f;


            water_rate =
                (current_water_level -
                 previous_water_level) /
                dt_min;
        }
    }
    else
    {
        water_rate = 0.0f;

        have_previous = 1;
    }


    previous_water_level =
        current_water_level;

    previous_time =
        now;


    printf("[WATER] Rate: ");

    PrintFloat2(water_rate);

    printf(" cm/min\r\n");


    /* TREND */

    if (water_rate >
        WATER_RAPID_THRESHOLD)
    {
        water_trend =
            WATER_RAPID_RISING;
    }
    else if (water_rate >
             WATER_RISING_THRESHOLD)
    {
        water_trend =
            WATER_RISING;
    }
    else if (water_rate <
             -WATER_RISING_THRESHOLD)
    {
        water_trend =
            WATER_FALLING;
    }
    else
    {
        water_trend =
            WATER_STABLE;
    }
}


/* ============================================================
   MPU6050 READ
   ============================================================ */

uint8_t MPU6050_Read(
    uint8_t reg,
    uint8_t *data,
    uint16_t len)
{
    if (HAL_I2C_Mem_Read(
            &hi2c1,
            MPU6050_ADDR,
            reg,
            I2C_MEMADD_SIZE_8BIT,
            data,
            len,
            100) == HAL_OK)
    {
        return 1;
    }


    return 0;
}


/* ============================================================
   MPU6050 INIT
   ============================================================ */

uint8_t MPU6050_Init(void)
{
    uint8_t who_am_i;

    uint8_t data;


    HAL_Delay(100);


    /* WAKE UP */

    data = 0x00;


    if (HAL_I2C_Mem_Write(
            &hi2c1,
            MPU6050_ADDR,
            MPU6050_PWR_MGMT_1,
            I2C_MEMADD_SIZE_8BIT,
            &data,
            1,
            100) != HAL_OK)
    {
        return 0;
    }


    HAL_Delay(100);


    /* WHO AM I */

    if (!MPU6050_Read(
            MPU6050_WHO_AM_I,
            &who_am_i,
            1))
    {
        return 0;
    }


    printf("MPU6050 WHO_AM_I = 0x%02X\r\n",
           who_am_i);


    if (who_am_i != 0x68 &&
        who_am_i != 0x70)
    {
        return 0;
    }


    /* SAMPLE RATE */

    data = 0x04;


    HAL_I2C_Mem_Write(
        &hi2c1,
        MPU6050_ADDR,
        MPU6050_SMPLRT_DIV,
        I2C_MEMADD_SIZE_8BIT,
        &data,
        1,
        100);


    /* DLPF */

    data = 0x03;


    HAL_I2C_Mem_Write(
        &hi2c1,
        MPU6050_ADDR,
        MPU6050_CONFIG,
        I2C_MEMADD_SIZE_8BIT,
        &data,
        1,
        100);


    /* ±2g */

    data = 0x00;


    HAL_I2C_Mem_Write(
        &hi2c1,
        MPU6050_ADDR,
        MPU6050_ACCEL_CONFIG,
        I2C_MEMADD_SIZE_8BIT,
        &data,
        1,
        100);


    return 1;
}


/* ============================================================
   VIBRATION UPDATE
   ============================================================ */

void UpdateVibrationSensor(void)
{
    float ax[VIBRATION_SAMPLES];

    float ay[VIBRATION_SAMPLES];

    float az[VIBRATION_SAMPLES];


    float mean_x = 0.0f;

    float mean_y = 0.0f;

    float mean_z = 0.0f;


    uint8_t buffer[6];

    uint8_t valid_samples = 0;


    /* COLLECT */

    for (uint8_t i = 0;
         i < VIBRATION_SAMPLES;
         i++)
    {
        if (MPU6050_Read(
                MPU6050_ACCEL_XOUT_H,
                buffer,
                6))
        {
            int16_t raw_x =
                (int16_t)
                ((buffer[0] << 8) |
                 buffer[1]);


            int16_t raw_y =
                (int16_t)
                ((buffer[2] << 8) |
                 buffer[3]);


            int16_t raw_z =
                (int16_t)
                ((buffer[4] << 8) |
                 buffer[5]);


            ax[valid_samples] =
                ((float)raw_x) /
                16384.0f;


            ay[valid_samples] =
                ((float)raw_y) /
                16384.0f;


            az[valid_samples] =
                ((float)raw_z) /
                16384.0f;


            mean_x +=
                ax[valid_samples];

            mean_y +=
                ay[valid_samples];

            mean_z +=
                az[valid_samples];


            valid_samples++;
        }


        HAL_Delay(50);
    }


    /* FAILURE */

    if (valid_samples < 10)
    {
        if (vibration_bad_cycles <
            SENSOR_FAULT_CYCLES)
        {
            vibration_bad_cycles++;
        }


        vibration_good_cycles = 0;


        if (vibration_bad_cycles >=
            SENSOR_FAULT_CYCLES)
        {
            vibration_health = 0;

            vibration_state =
                VIB_SENSOR_FAULT;
        }


        printf("[MPU] Communication problem.\r\n");

        return;
    }


    /* RECOVERY */

    vibration_bad_cycles = 0;


    if (vibration_good_cycles <
        SENSOR_RECOVERY_CYCLES)
    {
        vibration_good_cycles++;
    }


    if (vibration_good_cycles >=
        SENSOR_RECOVERY_CYCLES ||
        vibration_health == 0)
    {
        vibration_health = 1;
    }


    mean_x /=
        valid_samples;

    mean_y /=
        valid_samples;

    mean_z /=
        valid_samples;


    /* RMS */

    float sum_square = 0.0f;


    for (uint8_t i = 0;
         i < valid_samples;
         i++)
    {
        float dx =
            ax[i] - mean_x;

        float dy =
            ay[i] - mean_y;

        float dz =
            az[i] - mean_z;


        sum_square +=
            (dx * dx) +
            (dy * dy) +
            (dz * dz);
    }


    vibration_rms =
        sqrtf(sum_square /
              (3.0f *
               valid_samples));


    /* STATE */

    if (vibration_rms >=
        VIB_HIGH_THRESHOLD)
    {
        vibration_state =
            VIB_HIGH;
    }
    else if (vibration_rms >=
             VIB_LOW_THRESHOLD)
    {
        vibration_state =
            VIB_MEDIUM;
    }
    else
    {
        vibration_state =
            VIB_LOW;
    }


    printf("[MPU] Vibration RMS: ");

    PrintFloat3(vibration_rms);

    printf(" g\r\n");
}


/* ============================================================
   FUSION
   ============================================================ */

void UpdateFusion(void)
{
    /* SENSOR FAULT */

    if (!water_health ||
        !vibration_health)
    {
        fusion_state =
            FUSION_SENSOR_FAULT;

        hazard_count = 0;

        normal_count = 0;

        return;
    }


    uint8_t hazard = 0;


    /* RAPID WATER RISE */

    if (water_trend ==
        WATER_RAPID_RISING)
    {
        if (vibration_state ==
                VIB_MEDIUM ||
            vibration_state ==
                VIB_HIGH)
        {
            hazard = 3;
        }
        else
        {
            hazard = 2;
        }
    }


    /* NORMAL RISING */

    else if (water_trend ==
             WATER_RISING)
    {
        if (vibration_state ==
            VIB_HIGH)
        {
            hazard = 2;
        }
        else if (vibration_state ==
                 VIB_MEDIUM)
        {
            hazard = 1;
        }
    }


    /* STABLE/FALLING */

    else
    {
        if (vibration_state ==
                VIB_HIGH ||
            vibration_state ==
                VIB_MEDIUM)
        {
            hazard = 1;
        }
    }


    /* PERSISTENCE */

    if (hazard > 0)
    {
        normal_count = 0;


        if (hazard_count <
            HAZARD_PERSISTENCE)
        {
            hazard_count++;
        }
    }
    else
    {
        hazard_count = 0;


        if (normal_count <
            NORMAL_PERSISTENCE)
        {
            normal_count++;
        }
    }


    /* STATE */

    if (hazard_count >=
        HAZARD_PERSISTENCE)
    {
        if (hazard >= 3)
        {
            fusion_state =
                FUSION_CRITICAL;
        }
        else if (hazard == 2)
        {
            fusion_state =
                FUSION_WARNING;
        }
        else
        {
            fusion_state =
                FUSION_WATCH;
        }
    }
    else if (normal_count >=
             NORMAL_PERSISTENCE)
    {
        fusion_state =
            FUSION_NORMAL;
    }
}


/* ============================================================
   SX1278 SPI
   ============================================================ */

void LoRa_Select(void)
{
    HAL_GPIO_WritePin(
        LORA_NSS_PORT,
        LORA_NSS_PIN,
        GPIO_PIN_RESET);
}


void LoRa_Unselect(void)
{
    HAL_GPIO_WritePin(
        LORA_NSS_PORT,
        LORA_NSS_PIN,
        GPIO_PIN_SET);
}


/* ============================================================
   READ REGISTER
   ============================================================ */

uint8_t LoRa_ReadRegister(
    uint8_t address)
{
    uint8_t tx[2];

    uint8_t rx[2];


    tx[0] =
        address & 0x7F;

    tx[1] = 0x00;


    rx[0] = 0;
    rx[1] = 0;


    LoRa_Select();


    HAL_SPI_TransmitReceive(
        &hspi1,
        tx,
        rx,
        2,
        100);


    LoRa_Unselect();


    return rx[1];
}


/* ============================================================
   WRITE REGISTER
   ============================================================ */

void LoRa_WriteRegister(
    uint8_t address,
    uint8_t value)
{
    uint8_t tx[2];


    tx[0] =
        address | 0x80;

    tx[1] =
        value;


    LoRa_Select();


    HAL_SPI_Transmit(
        &hspi1,
        tx,
        2,
        100);


    LoRa_Unselect();
}


/* ============================================================
   RESET SX1278
   ============================================================ */

void LoRa_Reset(void)
{
    HAL_GPIO_WritePin(
        LORA_RESET_PORT,
        LORA_RESET_PIN,
        GPIO_PIN_RESET);

    HAL_Delay(10);

    HAL_GPIO_WritePin(
        LORA_RESET_PORT,
        LORA_RESET_PIN,
        GPIO_PIN_SET);

    HAL_Delay(20);
}


/* ============================================================
   SET FREQUENCY
   ============================================================ */

void LoRa_SetFrequency(
    uint32_t frequency)
{
    /*
     * FRF = frequency / 61.03515625 Hz
     */

    uint64_t frf =
        ((uint64_t)frequency << 19) /
        32000000UL;


    LoRa_WriteRegister(
        REG_FRF_MSB,
        (uint8_t)(frf >> 16));


    LoRa_WriteRegister(
        REG_FRF_MID,
        (uint8_t)(frf >> 8));


    LoRa_WriteRegister(
        REG_FRF_LSB,
        (uint8_t)frf);
}


/* ============================================================
   SET TX POWER
   ============================================================ */

void LoRa_SetTxPower(
    uint8_t power)
{
    if (power < 2)
    {
        power = 2;
    }


    if (power > 17)
    {
        power = 17;
    }


    /*
     * PA_BOOST:
     *
     * Output = 2 + OutputPower
     */

    uint8_t output =
        power - 2;


    LoRa_WriteRegister(
        REG_PA_CONFIG,
        0x80 | output);


    /*
     * Maximum current
     */

    LoRa_WriteRegister(
        REG_OCP,
        0x2B);
}


/* ============================================================
   SX1278 INITIALIZATION
   ============================================================ */

uint8_t LoRa_Init(void)
{
    uint8_t version;


    LoRa_Reset();


    /* Sleep + LoRa mode */

    LoRa_WriteRegister(
        REG_OP_MODE,
        MODE_LONG_RANGE_MODE |
        MODE_SLEEP);

    HAL_Delay(10);


    version =
        LoRa_ReadRegister(
            REG_VERSION);


    printf("SX1278 Version = 0x%02X\r\n",
           version);


    /*
     * SX1278 expected:
     * 0x12
     */

    if (version != 0x12)
    {
        return 0;
    }


    /* STANDBY */

    LoRa_WriteRegister(
        REG_OP_MODE,
        MODE_LONG_RANGE_MODE |
        MODE_STDBY);


    HAL_Delay(10);


    /* FREQUENCY */

    LoRa_SetFrequency(
        LORA_FREQUENCY_HZ);


    /* FIFO TX BASE */

    LoRa_WriteRegister(
        REG_FIFO_TX_BASE_ADDR,
        0x00);


    /* FIFO RX BASE */

    LoRa_WriteRegister(
        REG_FIFO_RX_BASE_ADDR,
        0x00);


    /* PA */

    LoRa_SetTxPower(
        LORA_TX_POWER);


    /*
     * LNA boost
     */

    LoRa_WriteRegister(
        REG_LNA,
        0x23);


    /*
     * Modem configuration 1:
     *
     * BW = 125 kHz
     * CR = 4/5
     * Explicit header
     */

    LoRa_WriteRegister(
        REG_MODEM_CONFIG1,
        0x72);


    /*
     * Modem configuration 2:
     *
     * SF7
     * CRC ON
     */

    LoRa_WriteRegister(
        REG_MODEM_CONFIG2,
        0x74);


    /*
     * Modem configuration 3:
     *
     * Low data rate optimization OFF
     * AGC ON
     */

    LoRa_WriteRegister(
        REG_MODEM_CONFIG3,
        0x04);


    /*
     * Preamble = 8
     */

    LoRa_WriteRegister(
        REG_PREAMBLE_MSB,
        0x00);

    LoRa_WriteRegister(
        REG_PREAMBLE_LSB,
        0x08);


    /*
     * DIO0 = TxDone
     */

    LoRa_WriteRegister(
        REG_DIO_MAPPING1,
        0x40);


    /*
     * Clear IRQ
     */

    LoRa_WriteRegister(
        REG_IRQ_FLAGS,
        0xFF);


    /*
     * STANDBY
     */

    LoRa_WriteRegister(
        REG_OP_MODE,
        MODE_LONG_RANGE_MODE |
        MODE_STDBY);


    HAL_Delay(10);


    return 1;
}


/* ============================================================
   LORA SEND PACKET
   ============================================================ */

uint8_t LoRa_SendPacket(
    uint8_t *data,
    uint8_t length)
{
    uint32_t start;


    if (length == 0 ||
        length > 255)
    {
        return 0;
    }


    /*
     * STANDBY
     */

    LoRa_WriteRegister(
        REG_OP_MODE,
        MODE_LONG_RANGE_MODE |
        MODE_STDBY);


    /*
     * FIFO pointer = TX base
     */

    LoRa_WriteRegister(
        REG_FIFO_ADDR_PTR,
        LoRa_ReadRegister(
            REG_FIFO_TX_BASE_ADDR));


    /*
     * Write packet into FIFO
     */

    for (uint8_t i = 0;
         i < length;
         i++)
    {
        LoRa_WriteRegister(
            REG_FIFO,
            data[i]);
    }


    /*
     * Payload length
     */

    LoRa_WriteRegister(
        REG_PAYLOAD_LENGTH,
        length);


    /*
     * Clear IRQ flags
     */

    LoRa_WriteRegister(
        REG_IRQ_FLAGS,
        0xFF);


    /*
     * TX mode
     */

    LoRa_WriteRegister(
        REG_OP_MODE,
        MODE_LONG_RANGE_MODE |
        MODE_TX);


    /*
     * Wait for TX DONE.
     *
     * DIO0 is also mapped to TX_DONE,
     * but checking IRQ register makes
     * this robust.
     */

    start =
        HAL_GetTick();


    while (1)
    {
        uint8_t irq =
            LoRa_ReadRegister(
                REG_IRQ_FLAGS);


        if (irq &
            IRQ_TX_DONE_MASK)
        {
            /*
             * Clear TX DONE
             */

            LoRa_WriteRegister(
                REG_IRQ_FLAGS,
                IRQ_TX_DONE_MASK);


            /*
             * Return to standby
             */

            LoRa_WriteRegister(
                REG_OP_MODE,
                MODE_LONG_RANGE_MODE |
                MODE_STDBY);


            return 1;
        }


        /*
         * Timeout = 5 seconds
         */

        if ((HAL_GetTick() -
             start) > 5000)
        {
            LoRa_WriteRegister(
                REG_OP_MODE,
                MODE_LONG_RANGE_MODE |
                MODE_STDBY);


            return 0;
        }
    }
}


