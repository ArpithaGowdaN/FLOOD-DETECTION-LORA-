int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_SPI1_Init();
    MX_USART2_UART_Init();

    DWT_Init();

    printf("\r\n");
    printf("========================================\r\n");
    printf("   FLOOD WARNING SENSOR FUSION NODE\r\n");
    printf("========================================\r\n");
    printf("STM32F446RE\r\n");
    printf("JSN-SR04T + MPU6050 + SX1278\r\n");
    printf("----------------------------------------\r\n");


    /* ========================================================
       MPU6050
       ======================================================== */

    printf("Initializing MPU6050...\r\n");

    if (MPU6050_Init())
    {
        printf("MPU6050 initialization SUCCESS.\r\n");

        vibration_health = 1;
    }
    else
    {
        printf("MPU6050 initialization FAILED.\r\n");

        vibration_health = 0;
    }


    printf("----------------------------------------\r\n");


    /* ========================================================
       LORA
       ======================================================== */

    printf("Initializing SX1278 LoRa...\r\n");

    if (LoRa_Init())
    {
        printf("SX1278 LoRa initialization SUCCESS.\r\n");
        printf("Frequency : 433 MHz\r\n");
        printf("Power     : 17 dBm\r\n");
        printf("SF        : 7\r\n");
        printf("BW        : 125 kHz\r\n");
        printf("CR        : 4/5\r\n");
        printf("CRC       : ENABLED\r\n");
    }
    else
    {
        printf("SX1278 LoRa initialization FAILED.\r\n");
    }


    printf("----------------------------------------\r\n");

    printf("Water reference: ");
    PrintFloat2(WATER_REFERENCE_CM);
    printf(" cm\r\n");

    printf("Water trend logic enabled.\r\n");

    printf("Fault requires 3 consecutive bad cycles.\r\n");

    printf("----------------------------------------\r\n");

    HAL_Delay(1000);


    /* ========================================================
       MAIN LOOP
       ======================================================== */

    while (1)
    {
        printf("\r\n");
        printf("========================================\r\n");
        printf("[LOOP] Reading sensors...\r\n");
        printf("========================================\r\n");


        /* ====================================================
           WATER
           ==================================================== */

        UpdateWaterSensor();


        /* ====================================================
           VIBRATION
           ==================================================== */

        UpdateVibrationSensor();


        /* ====================================================
           FUSION
           ==================================================== */

        UpdateFusion();


        /* ====================================================
           SERIAL STATUS
           ==================================================== */

        printf("\r\n");

        printf("WATER LEVEL : ");
        PrintFloat2(current_water_level);
        printf(" cm\r\n");

        printf("RATE        : ");
        PrintFloat2(water_rate);
        printf(" cm/min\r\n");

        printf("WATER TREND : %s\r\n",
               WaterTrendString(water_trend));

        printf("VIBRATION   : ");
        PrintFloat3(vibration_rms);
        printf(" g\r\n");

        printf("VIB STATE   : %s\r\n",
               VibrationString(vibration_state));

        printf("WATER HEALTH: %s\r\n",
               water_health ? "OK" : "FAULT");

        printf("VIB HEALTH  : %s\r\n",
               vibration_health ? "OK" : "FAULT");

        printf("FUSION      : %s\r\n",
               FusionString(fusion_state));


        /* ====================================================
           BUILD LORA PACKET
           ==================================================== */

        char packet[250];

        packet_number++;

        int packet_length = snprintf(
            packet,
            sizeof(packet),

            "ID=%s,"
            "PKT=%lu,"
            "LEVEL=",
            NODE_ID,
            (unsigned long)packet_number
        );

        /*
         * Append floating-point values manually so we don't
         * depend on printf floating-point support.
         */

        char temp[50];

        int temp_len;

        temp_len = snprintf(temp,
                            sizeof(temp),
                            "%ld.%02ld,"
                            "RATE=",
                            (long)((int32_t)(current_water_level * 100.0f) / 100),
                            (long)abs((int32_t)(current_water_level * 100.0f) % 100));

        if (packet_length + temp_len < sizeof(packet))
        {
            strcat(packet, temp);
            packet_length += temp_len;
        }


        /*
         * Replace the temporary LEVEL construction with a
         * reliable integer-scaled formatting approach.
         */

        packet[0] = '\0';

        strcat(packet, "ID=");
        strcat(packet, NODE_ID);

        strcat(packet, ",PKT=");

        char num[20];

        snprintf(num,
                 sizeof(num),
                 "%lu",
                 (unsigned long)packet_number);

        strcat(packet, num);


        /* LEVEL */

        strcat(packet, ",LEVEL=");

        int32_t level_scaled =
            (int32_t)(current_water_level * 100.0f + 0.5f);

        snprintf(num,
                 sizeof(num),
                 "%ld.%02ld",
                 (long)(level_scaled / 100),
                 (long)(level_scaled % 100));

        strcat(packet, num);


        /* RATE */

        strcat(packet, ",RATE=");

        int32_t rate_scaled =
            (int32_t)(water_rate * 100.0f);

        if (rate_scaled < 0)
        {
            strcat(packet, "-");

            rate_scaled = -rate_scaled;
        }

        snprintf(num,
                 sizeof(num),
                 "%ld.%02ld",
                 (long)(rate_scaled / 100),
                 (long)(rate_scaled % 100));

        strcat(packet, num);


        /* WATER TREND */

        strcat(packet, ",WT=");
        strcat(packet,
               WaterTrendString(water_trend));


        /* VIBRATION */

        strcat(packet, ",VIB=");

        int32_t vib_scaled =
            (int32_t)(vibration_rms * 1000.0f + 0.5f);

        snprintf(num,
                 sizeof(num),
                 "%ld.%03ld",
                 (long)(vib_scaled / 1000),
                 (long)(vib_scaled % 1000));

        strcat(packet, num);


        /* VIBRATION STATE */

        strcat(packet, ",VS=");
        strcat(packet,
               VibrationString(vibration_state));


        /* WATER HEALTH */

        strcat(packet, ",WH=");

        strcat(packet,
               water_health ? "OK" : "FAULT");


        /* VIBRATION HEALTH */

        strcat(packet, ",VH=");

        strcat(packet,
               vibration_health ? "OK" : "FAULT");


        /* FUSION */

        strcat(packet, ",FUSION=");

        strcat(packet,
               FusionString(fusion_state));


        /* ====================================================
           TRANSMIT
           ==================================================== */

        printf("\r\n[LORA] TX PACKET:\r\n");
        printf("%s\r\n", packet);

        uint8_t packet_len =
            (uint8_t)strlen(packet);

        if (packet_len > 0 &&
            packet_len < LORA_PACKET_MAX_LENGTH)
        {
            if (LoRa_SendPacket(
                    (uint8_t *)packet,
                    packet_len))
            {
                printf("[LORA] TX DONE\r\n");
            }
            else
            {
                printf("[LORA] TX FAILED / TIMEOUT\r\n");
            }
        }
        else
        {
            printf("[LORA] PACKET TOO LONG\r\n");
        }


        printf("========================================\r\n");


        /*
         * Wait before next decision/transmission.
         */
        HAL_Delay(500);
    }
}


/* ============================================================
